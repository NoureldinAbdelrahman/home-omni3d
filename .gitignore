# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# --- Raw OmniObject3D download (place data here; do not commit) ---
# dataset/ may be a symlink to a larger disk; ignore the link itself too.
/dataset
dataset/*
!dataset/.gitkeep

# --- Prepared model inputs (rebuild with prepare_model_data.py) ---
Pix2Vox/datasets/OmniObject3D/*
!Pix2Vox/datasets/OmniObject3D/.gitkeep

AtlasNet/dataset/data/*
!AtlasNet/dataset/data/.gitkeep
!AtlasNet/dataset/data/taxonomy.json

# --- Training outputs / logs / checkpoints ---
# (entries without a trailing slash so symlinked output dirs are ignored too)
Pix2Vox/output
AtlasNet/log
Pix2Vox/output/
AtlasNet/log/
*.pth
*.pt
*.ckpt
*.binvox

# --- AtlasNet runtime caches & media ---
**/training_media/
master.pkl
master.html

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# local weight caches (HDD symlinks)
point_e_model_cache

# --- viewer: local screenshots ---
viewer/.screenshots/

# --- Full-split qualitative triplets (bulky regenerable intermediates) ---
# Per-object scores live in the committed results_*.csv/summary_*.json files
# and the visuals in viewer/runs/; the .npy clouds rebuild via
# nesegemaa/atlas_qual.py (GPU, weights in AtlasNet/log/) or the
# pointe/triposr faithful_eval.py scripts. Legacy 5-object panel triplets
# stay tracked (already committed before this rule).
results/qualitative/atlasnet/*/
nesegemaa/pointe/triplets_full/
nesegemaa/triposr/triplets_full*/
